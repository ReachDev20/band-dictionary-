<template>
  <div class="page">
    <div if="{{!selectedWord}}" class="list-wrapper">
      <text class="heading">Lexicon</text>
      <list class="word-list">
        <list-item type="item" for="{{words}}" class="item-card" onclick="openWord($item)">
          <text class="item-title">{{$item.word}}</text>
          <text class="item-pos">{{$item.pos}}</text>
        </list-item>
      </list>
    </div>

    <div else class="detail-wrapper">
      <text class="detail-title">{{selectedWord.word}}</text>
      <text class="detail-pos">{{selectedWord.pos}}</text>
      <text class="detail-body">{{selectedWord.def}}</text>
      <input type="button" class="btn" value="Back" onclick="closeWord" />
    </div>
  </div>
</template>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #000000;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
  }
  .list-wrapper {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding-top: 16px;
  }
  .heading {
    color: #4CAF50;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 8px;
  }
  .word-list {
    width: 100%;
    height: 100%;
    flex-direction: column;
  }
  .item-card {
    width: 90%;
    margin-left: 5%;
    margin-bottom: 8px;
    padding: 10px;
    background-color: #222222;
    border-radius: 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
  .item-title {
    color: #ffffff;
    font-size: 20px;
  }
  .item-pos {
    color: #888888;
    font-size: 14px;
  }
  .detail-wrapper {
    width: 90%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    padding-top: 24px;
  }
  .detail-title {
    color: #4CAF50;
    font-size: 26px;
    font-weight: bold;
  }
  .detail-pos {
    color: #aaaaaa;
