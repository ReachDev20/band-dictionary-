    width: 120px;
    height: 38px;
    background-color: #333333;
    color: #ffffff;
    border-radius: 19px;
    font-size: 16px;
  }
</style>

<script>
  import dictionary from '../../common/dictionary.json';

  export default {
    data: {
      words: [],
      selectedWord: null
    },
    onInit() {
      this.words = dictionary;
    },
    openWord(item) {
      this.selectedWord = item;
    },
    closeWord() {
      this.selectedWord = null;
    }
  }
</script>
